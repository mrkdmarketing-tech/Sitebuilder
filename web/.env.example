# Copy to .env.local and fill in once the Supabase project exists.
# Leave both empty to run the app in SAMPLE DATA mode (no login, fake numbers).
# Both values are safe to expose in the browser (the anon key is public by design;
# row-level security in the database decides what each user can see).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
